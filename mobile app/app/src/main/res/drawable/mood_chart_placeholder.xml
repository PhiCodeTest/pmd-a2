<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F5F5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Background Grid Lines -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:color="#E0E0E0" android:width="1dp" android:dashWidth="2dp" android:dashGap="4dp" />
        </shape>
    </item>

    <!-- Chart Bars -->
    <item android:left="36dp" android:right="36dp" android:top="20dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Monday -->
    <item android:left="40dp" android:right="300dp" android:top="95dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#9BC366" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Tuesday -->
    <item android:left="80dp" android:right="260dp" android:top="115dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#9BC366" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Wednesday -->
    <item android:left="120dp" android:right="220dp" android:top="45dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#9BC366" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Thursday -->
    <item android:left="160dp" android:right="180dp" android:top="75dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#9BC366" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Friday -->
    <item android:left="200dp" android:right="140dp" android:top="85dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFC107" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Saturday -->
    <item android:left="240dp" android:right="100dp" android:top="100dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#9BC366" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Sunday -->
    <item android:left="280dp" android:right="60dp" android:top="65dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#9BC366" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Add days of week text at the bottom -->
    <item android:gravity="bottom|center_horizontal" android:bottom="20dp">
        <shape android:shape="rectangle">
            <size android:width="280dp" android:height="20dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list> 